    /// @notice Constructor-bound account initializers are released per EntryPoint by their account factories.
    function exclusionReason(string memory name) internal pure returns (string memory) {
        bytes32 key = keccak256(bytes(name));
        if (key == keccak256("AccountInit") || key == keccak256("AccountInit6900")) {
            return "EntryPoint constructor argument; released with the account factory";
        }
        return "";
