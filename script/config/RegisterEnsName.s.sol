pragma solidity ^0.8.30;

import {IETHRegistrar} from "@lattice/interfaces/external/ens/IETHRegistrar.sol";
import {IERC20} from "@lattice/interfaces/tokens/IERC20.sol";
import {Script, console} from "forge-std/Script.sol";

/// @dev Registration postconditions on the canonical Sepolia ETHRegistry.
interface IETHRegistryRecords {
    function findOwner(string calldata label) external view returns (address);
    function findTokenId(string calldata label) external view returns (uint256);
    function getSubregistry(string calldata label) external view returns (address);
    function getResolver(string calldata label) external view returns (address);
}

/// @title RegisterEnsName
/// @author David Dada <daveproxy80@gmail.com> (https://github.com/dadadave80)
/// @notice Commit a hash, then reveal a new .eth registration on Sepolia's ENSv2 ETHRegistrar.
/// @dev Compute keccak256(abi.encode(label,owner,secret,subregistry,resolver,duration,referrer))
///      offline. Store the randomly generated bytes32 secret privately until the commit is confirmed.
///      Run commit(bytes32) with only the hash. After MIN_COMMITMENT_AGE, set ENS_REGISTRATION_SECRET
///      from protected input and run reveal with --account, --sender <payer>, --slow and --broadcast.
///      See the ENSv2 operator guide for the tuple signature, token units, allowance cleanup and receipts.
contract RegisterEnsName is Script {
    IETHRegistrar internal constant REGISTRAR = IETHRegistrar(0xf633e7FC17e2bbE0D0965D18ec1821dcB754a3d3);
    IETHRegistryRecords internal constant REGISTRY = IETHRegistryRecords(0xD4eBcbBdF463C9c45784603Db0dDD499BC44A8B4);

    /// @dev The seven-field commitment additionally binds the secret as the third field.
    struct Registration {
        string label;
        address owner;
        address subregistry;
        address resolver;
        uint64 duration;
        bytes32 referrer;
    }

    function commit(bytes32 hash) external {
        _checkNetwork();
        require(hash != bytes32(0), "Empty commitment");
        uint256 committedAt = REGISTRAR.commitmentAt(hash);
        if (committedAt != 0) {
            require(
                block.timestamp < committedAt + REGISTRAR.MAX_COMMITMENT_AGE(), "Commitment expired; use a fresh secret"
            );
            console.log("Commitment already recorded at", committedAt);
            return;
        }
        vm.broadcast(msg.sender);
        REGISTRAR.commit(hash);
    }

    /// @notice Register for at most maxSpend base units. An exact allowance left by an interrupted run can be reused.
    /// @dev Recheck receipts and residual allowance after mining. A previously approved higher quote requires
    ///      the payer to clear that allowance explicitly before retrying.
    function reveal(Registration calldata r, address paymentToken, uint256 maxSpend)
        external
        returns (uint256 tokenId)
    {
        _checkNetwork();
        require(r.owner != address(0) && r.resolver.code.length != 0, "Invalid owner or resolver");
        require(r.subregistry == address(0) || r.subregistry.code.length != 0, "Invalid subregistry");
        if (REGISTRY.findOwner(r.label) != address(0)) {
            tokenId = _verifyRegistered(r);
            console.log("Name already has the requested owner and pointers. Current token ID:", tokenId);
            return tokenId;
        }
        require(r.duration >= REGISTRAR.MIN_REGISTER_DURATION(), "Registration duration too short");
        require(REGISTRAR.isAvailable(r.label), "Name unavailable");
        bytes32 secret = _confirmedSecret(r);
        _approveQuote(r, IERC20(paymentToken), maxSpend);
        vm.broadcast(msg.sender);
        tokenId = REGISTRAR.register(
            r.label, r.owner, secret, r.subregistry, r.resolver, r.duration, paymentToken, r.referrer
        );
        require(tokenId == _verifyRegistered(r), "Unexpected token ID");
        console.log("Check mined NameRegistered event and remaining registrar allowance. Token ID:", tokenId);
    }

    function _confirmedSecret(Registration calldata r) private view returns (bytes32 secret) {
        secret = vm.envBytes32("ENS_REGISTRATION_SECRET");
        require(secret != bytes32(0), "Empty secret");
        bytes32 hash =
            keccak256(abi.encode(r.label, r.owner, secret, r.subregistry, r.resolver, r.duration, r.referrer));
        uint256 at = REGISTRAR.commitmentAt(hash);
        require(at != 0, "Commitment missing");
        require(block.timestamp >= at + REGISTRAR.MIN_COMMITMENT_AGE(), "Commitment too young");
        require(block.timestamp < at + REGISTRAR.MAX_COMMITMENT_AGE(), "Commitment expired; use a fresh secret");
    }

    function _approveQuote(Registration calldata r, IERC20 token, uint256 maxSpend) private {
        (uint256 base, uint256 premium) = REGISTRAR.getRegisterPrice(r.label, r.duration, address(token));
        uint256 quote = base + premium;
        require(quote <= maxSpend, "Quote exceeds spending cap");
        require(token.balanceOf(msg.sender) >= quote, "Insufficient payment token balance");
        console.log("Registration quote in token base units:", quote);
        console.log("Payment token decimals:", uint256(token.decimals()));
        uint256 allowance = token.allowance(msg.sender, address(REGISTRAR));
        if (allowance == quote) return;
        require(allowance == 0, "Clear existing allowance or use a dedicated payer");
        vm.broadcast(msg.sender);
        require(token.approve(address(REGISTRAR), quote), "Payment token approval failed");
        require(token.allowance(msg.sender, address(REGISTRAR)) == quote, "Unexpected registrar allowance");
    }

    function _checkNetwork() private view {
        require(block.chainid == 11155111, "Sepolia only");
        require(REGISTRAR.ETH_REGISTRY() == address(REGISTRY), "Unexpected ETH registry");
    }

    function _verifyRegistered(Registration calldata r) private view returns (uint256) {
        require(REGISTRY.findOwner(r.label) == r.owner, "Registered owner differs");
        require(
            REGISTRY.getSubregistry(r.label) == r.subregistry && REGISTRY.getResolver(r.label) == r.resolver,
            "Registered pointers differ"
        );
        return REGISTRY.findTokenId(r.label);
    }
}
