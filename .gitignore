# Compiler files
cache/
out/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Docs (auto-generated by `forge doc`)
docs/*
# But keep hand-authored docs under docs/superpowers/.
!docs/superpowers/
# Keep hand-authored audit reports.
!docs/audit/

# Dotenv file
.env
