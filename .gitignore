# Compiler files
cache/
out/

# Auto-generated by `vm.stopSnapshotGas()` — persistent baseline is `.gas-snapshot`
snapshots/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Docs — local only, not tracked (forge doc output, hand-authored notes, CLAUDE.md)
docs/

# Dotenv file
.env

# CCTP USDC demo loop journals + its lock dir (.lock) and atomic-write temps (.env.XXXXXX / .burnerr.XXXXXX)
.cctp-demo.*
# Keystore-password files for unattended cranks (--password-file); the runbook names .demo.pw.
# NEVER commit these — they hold the keystore password.
*.pw
.demo.pw

# CI-generated contract-size report (forge build --sizes --json)
sizes.json
