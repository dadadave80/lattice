# Compiler files
cache/
out/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/
# Only `-latest` broadcasts are tracked as evidence; per-run timestamped copies stay local.
/broadcast/**/run-1*.json
/broadcast/multi/*.s.sol-1*

# Docs — local only, not tracked (forge doc output, hand-authored notes, CLAUDE.md)
docs/

# Dotenv file
.env

# CCTP USDC demo loop journals + its lock dir (.lock) and atomic-write temps (.env.XXXXXX / .burnerr.XXXXXX)
.cctp-demo.*
# Keystore-password files for unattended cranks (--password-file); the runbook names .demo.pw.
# NEVER commit these — they hold the keystore password.
*.pw
.demo.pw

# CI-generated contract-size report (forge build --sizes --json)
sizes.json

# Authored guides, architecture decision records and the docs site's committed sources (package.json,
# lockfile, Vocs config); generated pages (forge doc), the build, node_modules and local notes remain ignored.
!docs/
docs/*
!docs/adr/
!docs/guides/
docs/guides/*
!docs/guides/compose-your-own-diamond.md
!docs/guides/hedera.md
!docs/guides/quickstart.md
!docs/guides/selector-compatibility.md
!docs/site/
docs/site/*
!docs/site/package.json
!docs/site/package-lock.json
!docs/site/vocs.config.ts
!docs/security/
docs/security/*
!docs/security/registry-factory-threat-model.md

# Local Gambit mutation pilot output (make mutation)
/gambit_out/
