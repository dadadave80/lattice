# =============================================================================
#  Lattice — environment template. Copy to `.env` and fill in what you need.
#
#  The RPC URLs below are FREE PUBLIC endpoints (rate-limited, best-effort) so
#  scripts and fork tests work out of the box. Swap in a dedicated provider
#  (Alchemy / Infura / QuickNode / drpc / …) for production or heavy forking.
#  Each var maps 1:1 to a `foundry.toml` [rpc_endpoints] alias of the same chain,
#  e.g. `forge script ... --rpc-url base` or `vm.createSelectFork("base")`.
#  Fork tests read `MAINNET_RPC_URL` directly (skipped if unset).
# =============================================================================

# ---- API keys -------------------------------------------------------------
# Etherscan V2: one key works across all Etherscan-family explorers (by chainid).
ETHERSCAN_API_KEY=

# ---- Deployer (prefer a keystore over a raw key) --------------------------
PRIVATE_KEY=
ETH_KEYSTORE_ACCOUNT=
WALLET_ADDR=

# ---- Mainnet RPCs ---------------------------------------- (alias       id)
